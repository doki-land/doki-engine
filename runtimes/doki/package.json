{
    "name": "@doki-land/doki",
    "version": "0.0.5",
    "description": "Doki — Node CLI + N-API Rust build kernel (user-facing entry)",
    "license": "MIT",
    "type": "module",
    "bin": {
        "doki": "./bin/doki.js"
    },
    "main": "./src/index.mjs",
    "types": "./native/index.d.ts",
    "exports": {
        ".": {
            "import": "./src/index.mjs",
            "default": "./src/index.mjs"
        },
        "./native": {
            "require": "./native/index.cjs",
            "types": "./native/index.d.ts",
            "default": "./native/index.cjs"
        }
    },
    "files": [
        "bin",
        "src",
        "templates",
        "native"
    ],
    "scripts": {
        "test": "node --test test/*.test.mjs",
        "stage:native": "node ../../scripts/stage-doki-native.mjs"
    },
    "dependencies": {
        "@doki-land/doki-plugin": "workspace:*"
    },
    "optionalDependencies": {
        "@doki-land/doki-win32-x64": "0.0.0",
        "@doki-land/doki-win32-arm64": "0.0.0",
        "@doki-land/doki-darwin-x64": "0.0.0",
        "@doki-land/doki-darwin-arm64": "0.0.0",
        "@doki-land/doki-linux-x64-gnu": "0.0.0",
        "@doki-land/doki-linux-arm64-gnu": "0.0.0",
        "@doki-land/doki-linux-x64-musl": "0.0.0",
        "@doki-land/doki-linux-arm64-musl": "0.0.0"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/doki-land/doki-engine.git",
        "directory": "runtimes/doki"
    }
}
