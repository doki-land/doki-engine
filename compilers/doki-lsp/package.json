{
    "name": "@doki-land/doki-lsp",
    "version": "0.0.0",
    "private": true,
    "description": "DEPRECATED — use Rust `dejavu lsp` for IDE. This Node LSP is historical only.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts",
        "dev": "tsup src/index.ts --format esm --dts --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@doki-land/dejavu-engine": "0.0.0",
        "vscode-languageserver": "^9.0.0",
        "vscode-languageserver-textdocument": "^1.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.4.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^2.1.8"
    }
}
