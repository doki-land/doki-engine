{
    "name": "@doki-land/doki-deploy",
    "version": "0.0.0",
    "private": true,
    "description": "Private legacy helpers — product entry is `doki deploy` (@doki-land/doki)",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "templates"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "doki",
        "deploy",
        "netlify",
        "vercel",
        "github-pages",
        "cloudflare"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^25.4.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^2.1.8"
    }
}
