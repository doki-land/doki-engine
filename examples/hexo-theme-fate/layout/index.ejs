<section class="hero with-cover" style="<% if (page.cover) { %>--cover: url('<%- url_for(page.cover) %>');<% } %>">
  <p class="eyebrow"><%= config.author || 'Fate' %></p>
  <h1><%= page.title %></h1>
  <% if (page.description) { %>
    <p class="hero-copy"><%= page.description %></p>
  <% } %>
</section>

<section class="post-list">
  <% site.posts.each(function(post) { %>
    <%- partial('_partial/post-row', { post: post }) %>
  <% }) %>
</section>
