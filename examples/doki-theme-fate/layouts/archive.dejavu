<!DOCTYPE html>
<html lang="<% site.lang %>">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title><% page.title %> · <% site.title %></title>
<% if page.description %>
<meta name="description" content="<% page.description %>"/>
<% else if site.description %>
<meta name="description" content="<% site.description %>"/>
<% end if %>
<% if site.baseUrl && page.permalink %>
<link rel="canonical" href="<% site.baseUrl %><% page.permalink %>"/>
<% end if %>
<link rel="stylesheet" href="/assets/style.css"/>
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/"><% site.title %></a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/">首页</a>
      <a href="/archive/">归档</a>
      <a href="/tags/">标签</a>
      <a href="/gallery/">相册</a>
      <a href="/about/">关于</a>
    </nav>
  </div>
</header>

<main class="site-main">
  <article class="site-article">
    <header class="article-header">
      <% if page.title %>
      <h1 class="article-title"><% page.title %></h1>
      <% end if %>
      <div class="article-meta">
        <% if page.date %>
        <time class="article-date" datetime="<% page.date %>"><% page.date %></time>
        <% end if %>
      </div>
    </header>
    <div class="article-content">
      <% content |> safe %>
      <ul class="post-list">
        <% loop post in site.posts %>
        <li>
          <time class="post-date" datetime="<% post.date %>"><% post.date %></time>
          <a class="post-link" href="<% post.url %>"><% post.title %></a>
        </li>
        <% end loop %>
      </ul>
    </div>
  </article>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">© <% site.author %></p>
    <p class="footer-powered">Built with Doki · Fate theme</p>
  </div>
</footer>
</body>
</html>
