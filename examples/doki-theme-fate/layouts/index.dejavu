<!DOCTYPE html>
<html lang="<% site.lang %>">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title><% page.title %> · <% site.title %></title>
<% if site.description %>
<meta name="description" content="<% site.description %>"/>
<% end if %>
<% if page.description %>
<meta name="description" content="<% page.description %>"/>
<% end if %>
<link rel="stylesheet" href="/assets/style.css"/>
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/"><% site.title %></a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/">首页</a>
      <a href="/archive/">归档</a>
      <a href="/tags/">标签</a>
      <a href="/gallery/">相册</a>
      <a href="/about/">关于</a>
    </nav>
  </div>
</header>

<main class="site-main home-main">
  <section class="hero">
    <% if page.title %>
    <p class="eyebrow"><% site.title %></p>
    <h1 class="hero-title"><% page.title %></h1>
    <% end if %>
    <% if page.description %>
    <p class="hero-copy"><% page.description %></p>
    <% end if %>
  </section>
  <article class="site-article home-content">
    <div class="article-content">
      <% content |> safe %>
    </div>
  </article>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">© <% site.author %></p>
    <% if site.description %>
    <p class="footer-tagline"><% site.description %></p>
    <% end if %>
    <p class="footer-powered">Built with Doki · Fate theme</p>
  </div>
</footer>
</body>
</html>
